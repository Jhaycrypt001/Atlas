node_modules/
# Every .env variant holds live keys. `.env` alone did NOT cover backups like
# .env.testnet.bak, which a `git add -A` would have committed.
.env
.env.*
!.env.example
dist/
*.log
.keys/
scratch/

# OKX A2A identity material. The ENCRYPTED bundle (deploy/okx-identity.tgz.enc)
# is intentionally committed; the plaintext identity must NEVER be. Block every
# plaintext form so `git add -A` can't leak XMTP private keys.
*.tgz
*.tar
*.tar.gz
*.db3
*.db3-shm
*.db3-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
!deploy/okx-identity.tgz.enc

# onchainos wallet session bundle (deploy/pack-onchainos-session.sh output). This
# holds keyring.enc — the OWNER WALLET's private key material — plus a live session
# credential. This repo is PUBLIC, so it must never be committed in any form,
# encrypted or not. It travels as the Render env var OKX_ONCHAINOS_SESSION_B64.
onchainos-session.b64
*.b64
.onchainos/
