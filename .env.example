# ---- X Layer testnet deployment (P0) ----
XLAYER_RPC=https://testrpc.xlayer.tech
XLAYER_CHAIN_ID=1952
PK=0xYOUR_FUNDED_TESTNET_KEY
XLAYER_USDC=0x0000000000000000000000000000000000000000   # USDC on X Layer testnet (from faucet/docs)
XLAYER_TREASURY=0x0000000000000000000000000000000000000000  # agent fee wallet

# ---- X Layer MAINNET (required for the OKX.AI listing: x402 must advertise eip155:196) ----
# Swap the four values above for these. Verified against okx/xlayer-tokenlist and
# read back from the live contract at chain 196 (name="USD Coin", version="2",
# decimals=6, TRANSFER_WITH_AUTHORIZATION_TYPEHASH present -> EIP-3009 supported).
# XLAYER_RPC=https://rpc.xlayer.tech
# XLAYER_CHAIN_ID=196
# XLAYER_USDC=0x74b7F16337b8972027F6196A17a631aC6dE26d22   # canonical USDC on X Layer mainnet
# XLAYER_TREASURY=0xYOUR_MAINNET_FEE_WALLET
# PK=0xYOUR_FUNDED_MAINNET_KEY
# The token's EIP-712 domain, used to verify EIP-3009 payment signatures. These
# MUST match the contract exactly or every payment is rejected.
# XLAYER_USDC_NAME=USD Coin
# XLAYER_USDC_VERSION=2
# Mainnet also requires: ALLOW_INSECURE_TLS=0, DEMO_MODE=0, and escrow/attestation
# contracts redeployed to 196 (see deployments/). assertMainnetSafe() enforces the first two.

# ---- LLM planner (optional; falls back to rule-based) ----
LLM_API_KEY=

# ---- OKX.AI ASP conformance (asp/1.0 + x402) ----
ASP_HANDLE=atlas                                  # entity handle in the manifest / ASP-Sig
ASP_BASE_URL=http://localhost:4173                # public base URL OKX.AI discovers (https in prod)
ASP_PAID=0                                         # 1 = enable x402 402 pay-per-call on /asp/run
ASP_PRICE=10000                                    # per-call price in token base units (0.01 USDC @ 6dp)
# Stable Ed25519 identity across restarts (PKCS8 PEM). Leave empty for an ephemeral key.
ASP_PRIVATE_KEY=

# ---- Safety / limits ----
# Agent-FUNDED demo path (POST /intent spends the agent's own funds, no auth).
# OFF by default — enable ONLY for a trusted local demo, never on a public host.
DEMO_MODE=0
# Per-tx spend cap for the value tier, in whole USDC (blocks oversized settlements).
MAX_VALUE_USDC=10000
# Rate limit on money/gas-spending routes: RATE_MAX requests per RATE_WINDOW_MS per IP.
RATE_MAX=20
RATE_WINDOW_MS=60000
# Max tasks kept in the in-memory ledger (older ones are evicted).
LEDGER_MAX=500
# Escape hatch for TLS-verification-disabled environments (testnet only; never mainnet).
ALLOW_INSECURE_TLS=0
